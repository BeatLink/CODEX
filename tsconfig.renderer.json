{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "outDir": "dist/renderer",
        "rootDir": "src/renderer",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    },
    "include": ["src/renderer/**/*.ts"],
    "exclude": ["src/renderer/**/*.test.ts"]
}
