{
    "name": "codex",
    "desktopName": "org.codex.CODEX.desktop",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/main/index.js",
    "bin": {
        "codex": "dist/cli/index.js",
        "codex-daemon": "dist/daemon/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && cp -f src/renderer/index.html src/renderer/styles.css src/renderer/tray-icon.png dist/renderer/",
        "start": "env -u ELECTRON_RUN_AS_NODE ${ELECTRON:-electron} dist/main/index.js",
        "dev": "npm run build && npm start",
        "daemon": "node dist/daemon/index.js",
        "eval": "node dist/core/evaluation.js",
        "recall-benchmark": "node dist/core/recallBenchmark.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "cli": "node dist/cli/index.js"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "electron": "^43.8.7",
        "typescript": "^5.6.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@x-tech-laboratories/roboeyes": "github:x-tech-laboratories/RoboEyes#8de418a41e18db875605e4c74c778800625410d7",
        "force-graph": "^1.52.0",
        "node-llama-cpp": "^3.22.2",
        "sqlite-vec": "^0.1.9",
        "yaml": "^2.9.1"
    },
    "description": "A task-tree harness for locally run language models",
    "license": "GPL-3.0-or-later"
}
