{
    "name": "codex",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && mkdir -p dist/renderer && cp -f src/renderer/index.html dist/renderer/index.html",
        "start": "electron dist/main/index.js",
        "dev": "npm run build && electron dist/main/index.js",
        "daemon": "node dist/daemon/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "electron": "^43.8.7",
        "typescript": "^5.6.3",
        "vitest": "^2.1.8"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "node-llama-cpp": "^3.22.2",
        "sqlite-vec": "^0.1.9"
    },
    "description": "A task-tree harness for locally run language models",
    "license": "GPL-3.0-or-later"
}
