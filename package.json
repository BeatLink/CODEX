{
    "name": "codex",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && cp -f src/renderer/index.html src/renderer/styles.css dist/renderer/",
        "start": "${ELECTRON:-electron} dist/main/index.js",
        "dev": "npm run build && electron dist/main/index.js",
        "daemon": "node dist/daemon/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "electron": "^43.8.7",
        "typescript": "^5.6.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "node-llama-cpp": "^3.22.2",
        "sqlite-vec": "^0.1.9"
    },
    "description": "A task-tree harness for locally run language models",
    "license": "GPL-3.0-or-later"
}
