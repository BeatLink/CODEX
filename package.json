{
    "name": "codex-electron",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "dist/main/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json && mkdir -p dist/renderer && cp -f src/renderer/index.html dist/renderer/index.html",
        "dev": "npm run build && electron dist/main/index.js",
        "start": "electron dist/main/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "electron": "^33.2.0",
        "typescript": "^5.6.3",
        "vitest": "^2.1.8"
    }
}