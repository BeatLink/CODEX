{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": [
            "node",
            "vitest/globals"
        ],
        "resolveJsonModule": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.ts"
    ]
}